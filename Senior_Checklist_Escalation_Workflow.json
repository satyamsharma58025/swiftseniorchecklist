      "name": "Trigger: Senior Submits Form",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [-1600, 0],
      "parameters": {
        "pollTimes": { "item": [ { "mode": "everyX", "unit": "minutes", "value": 2 } ] },
        "documentId": { "__rl": true, "value": "SHEET_ID_PLACEHOLDER", "mode": "id" },
