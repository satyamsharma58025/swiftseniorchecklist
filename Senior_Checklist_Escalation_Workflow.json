    },
    {
      "id": "read-task-master",
      "name": "Read Task Master",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [-1376, -400],
      "parameters": {
        "documentId": { "__rl": true, "value": "SHEET_ID_PLACEHOLDER", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Task Master", "mode": "name" },
        "options": { "dataLocationOnSheet": { "values": { "rangeDefinition": "specifyRange", "headerRow": 1, "firstDataRow": 2 } } }
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "GOOGLE_SHEETS_CRED_ID", "name": "Google Sheets account" } }
    },
    {
      "id": "code-expand-cadence",
      "name": "Expand Cadence -> Today's Instances",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1152, -400],
      "parameters": {
        "jsCode": "// Expands Task Master rows into today's Daily Checklist instances based on Cadence.\nconst ZONE = 'Asia/Kolkata';\nconst today = DateTime.now().setZone(ZONE);\nconst todayStr = today.toFormat('yyyy-MM-dd');\nconst weekday = today.toFormat('cccc'); // 'Monday' etc.\nconst dayOfMonth = today.day;\n\nfunction isActive(row) {\n  const active = String(row['Active (Y/N)'] || '').trim().toUpperCase() === 'Y';\n  if (!active) return false;\n  const start = row['Start Date'] ? DateTime.fromISO(String(row['Start Date']), { zone: ZONE }) : null;\n  const end = row['End Date'] ? DateTime.fromISO(String(row['End Date']), { zone: ZONE }) : null;\n  if (start && start.isValid && today.startOf('day') < start.startOf('day')) return false;\n  if (end && end.isValid && today.startOf('day') > end.startOf('day')) return false;\n  return true;\n}\n\nfunction isDueToday(row) {\n  const cadence = String(row['Cadence (Daily/Weekly/Monthly)'] || '').trim().toLowerCase();\n  const detail = String(row['Schedule Detail (Weekday / Day-of-Month)'] || '').trim().toLowerCase();\n  if (cadence === 'daily') return true;\n  if (cadence === 'weekly') return detail.includes(weekday.toLowerCase());\n  if (cadence === 'monthly') {\n    const n = parseInt(detail, 10);\n    return Number.isFinite(n) && n === dayOfMonth;\n  }\n  return false;\n}\n\nconst rows = $input.all().map(i => i.json);\nconst out = [];\nlet seq = 1;\n\nfor (const row of rows) {\n  const taskId = String(row['Task ID'] || '').trim();\n  if (!taskId) continue;\n  if (!isActive(row)) continue;\n  if (!isDueToday(row)) continue;\n\n  const checklistId = `CL-${todayStr.replace(/-/g,'')}-${String(seq).padStart(3,'0')}`;\n  seq++;\n\n  out.push({\n    json: {\n      'Checklist ID': checklistId,\n      'Date': todayStr,\n      'Task ID': taskId,\n      'Employee Name': row['Employee Name'] || '',\n      'Employee Phone': row['Employee Phone'] || '',\n      'Task Description': row['Task Description'] || '',\n      'Status': 'Pending',\n      'Senior Remarks': '',\n      'Reminder Count': '0',\n      'Last Reminded': '',\n      'Escalated (Y/N)': 'N',\n      'Escalated At': '',\n      'Supervisor Name': row['Supervisor Name'] || '',\n      'Supervisor Phone': row['Supervisor Phone'] || '',\n      'Escalation Threshold': row['Escalation Threshold'] || 2\n    }\n  });\n}\n\nreturn out;"
      }
    },
