    {
      "id": "trigger-reminder-sweep",
      "name": "Every 4h - Reminder Sweep (Still Pending/Not Done)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1600, 400],
      "parameters": {
        "rule": { "interval": [ { "field": "hours", "hoursInterval": 4 } ] }
      },
      "notes": "Independent sweep so ripple reminders continue even without a new form submission that day. Uses REMINDER_INTERVAL_HOURS and ESCALATION_THRESHOLD_DEFAULT from README & Settings."
    },
    {
      "id": "read-open-checklist-rows",
      "name": "Read Open Checklist Rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [-1376, 400],
      "parameters": {
        "documentId": { "__rl": true, "value": "SHEET_ID_PLACEHOLDER", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Daily Checklist", "mode": "name" },
        "options": { "dataLocationOnSheet": { "values": { "rangeDefinition": "specifyRange", "headerRow": 1, "firstDataRow": 2 } } }
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "GOOGLE_SHEETS_CRED_ID", "name": "Google Sheets account" } }
    },
    {
      "id": "code-filter-sweep-due",
      "name": "Filter: Not Done + Interval Elapsed + Not Escalated",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1152, 400],
      "parameters": {
        "jsCode": "const ZONE = 'Asia/Kolkata';\nconst now = DateTime.now().setZone(ZONE);\nconst todayStr = now.toFormat('yyyy-MM-dd');\nconst REMINDER_INTERVAL_HOURS = 4; // mirrors README & Settings!B9 -- keep in sync or fetch dynamically\n\nconst rows = $input.all().map(i => i.json);\nconst out = [];\n\nfor (const r of rows) {\n  if (String(r['Date']) !== todayStr) continue;\n  if (String(r['Escalated (Y/N)']).toUpperCase() === 'Y') continue;\n  if (String(r['Status']) === 'Done') continue;\n  if (String(r['Status']) !== 'Not Done') continue; // only chase tasks the senior already flagged Not Done\n\n  const last = r['Last Reminded'] ? DateTime.fromFormat(String(r['Last Reminded']), 'yyyy-MM-dd HH:mm', { zone: ZONE }) : null;\n  const dueForReminder = !last || !last.isValid || now.diff(last, 'hours').hours >= REMINDER_INTERVAL_HOURS;\n  if (!dueForReminder) continue;\n\n  out.push({ json: r });\n}\nreturn out;"
      }
    },
