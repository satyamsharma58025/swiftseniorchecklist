    {
      "id": "code-process-response",
      "name": "Parse Done / Not-Done + Remarks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1376, 0],
      "parameters": {
        "jsCode": "// Expects the form's checkbox answer as comma-separated Checklist IDs marked Done,\n// and remarks as lines of \"CL-xxxx: reason\".\nconst row = $input.first().json;\nconst doneRaw = String(row['Checklist IDs Marked Done (raw)'] || '');\nconst doneIds = new Set(doneRaw.split(',').map(s => s.trim()).filter(Boolean));\n\nconst remarksRaw = String(row['Remarks for Not Done Tasks (raw)'] || '');\nconst remarksMap = {};\nfor (const line of remarksRaw.split('\\n')) {\n  const m = line.match(/^(CL-[0-9A-Za-z-]+)\\s*:\\s*(.+)$/);\n  if (m) remarksMap[m[1].trim()] = m[2].trim();\n}\n\nreturn [{ json: { doneIds: Array.from(doneIds), remarksMap, submittedAt: row['Timestamp'] || '' } }];"
      }
    },
    {
      "id": "read-todays-checklist",
      "name": "Read Today's Checklist Rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [-1152, 0],
      "parameters": {
        "documentId": { "__rl": true, "value": "SHEET_ID_PLACEHOLDER", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Daily Checklist", "mode": "name" },
        "filtersUI": { "values": [ { "lookupColumn": "Date", "lookupValue": "={{ $now.setZone('Asia/Kolkata').toFormat('yyyy-MM-dd') }}" } ] },
        "options": { "dataLocationOnSheet": { "values": { "rangeDefinition": "specifyRange", "headerRow": 1, "firstDataRow": 2 } } }
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "GOOGLE_SHEETS_CRED_ID", "name": "Google Sheets account" } }
    },
    {
      "id": "code-build-updates-and-not-done",
      "name": "Build Row Updates + Not-Done List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-928, 0],
      "parameters": {
        "jsCode": "const parsed = $('Parse Done / Not-Done + Remarks').first().json;\nconst rows = $input.all().map(i => i.json);\n\nconst updates = [];\nconst notDoneForRipple = [];\n\nfor (const r of rows) {\n  const id = r['Checklist ID'];\n  const isDone = parsed.doneIds.includes(id);\n  const remark = parsed.remarksMap[id] || '';\n\n  const updated = {\n    ...r,\n    'Status': isDone ? 'Done' : 'Not Done',\n    'Senior Remarks': remark\n  };\n  updates.push({ json: updated });\n\n  if (!isDone) notDoneForRipple.push({ json: updated });\n}\n\n// Output both streams tagged so downstream nodes can branch\nreturn [\n  ...updates.map(u => ({ json: { ...u.json, _stream: 'update' } })),\n  ...notDoneForRipple.map(u => ({ json: { ...u.json, _stream: 'ripple' } }))\n];"
      }
    },
    {
      "id": "switch-stream",
      "name": "Route: Update vs Ripple",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [-704, 0],
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "conditions": [ { "leftValue": "={{ $json._stream }}", "rightValue": "update", "operator": { "type": "string", "operation": "equals" } } ] }, "outputKey": "update" },
            { "conditions": { "conditions": [ { "leftValue": "={{ $json._stream }}", "rightValue": "ripple", "operator": { "type": "string", "operation": "equals" } } ] }, "outputKey": "ripple" }
          ]
        }
      }
    },
