    {
      "id": "increment-reminder-count",
      "name": "Increment Reminder Count",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-256, 80],
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(i => {\n  const row = i.json;\n  const oldCount = parseInt(row['Reminder Count'] || '0', 10) || 0;\n  const newCount = oldCount + 1;\n  const threshold = parseInt(row['Escalation Threshold'] || '2', 10) || 2;\n  return {\n    json: {\n      ...row,\n      'Reminder Count': String(newCount),\n      'Last Reminded': DateTime.now().setZone('Asia/Kolkata').toFormat('yyyy-MM-dd HH:mm'),\n      '_shouldEscalate': newCount >= threshold\n    }\n  };\n});"
      }
    },
