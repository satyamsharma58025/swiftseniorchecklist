      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        70
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config (Send Form)').first().json.APP_BASE_URL }}/api/notifications/log",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 90000
        },
        "sendBody": true,
