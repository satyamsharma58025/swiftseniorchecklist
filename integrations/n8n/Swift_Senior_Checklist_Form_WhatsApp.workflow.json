      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_APP_SECRET_CRED",
          "name": "Swift App Secret (x-cron-secret)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 8000
    },
    {
      "id": "00000000-0000-0000-0000-0000000d5503",
      "name": "Note: Flow B",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -1180,
        310
      ],
      "parameters": {
        "content": "## B. Form submitted -> update the app -> (optional) WhatsApp the employees\nGoogle Form -> Apps Script -> this webhook -> app updates the checklist (the app now shows the answers).\nWe answer the webhook as soon as the app is updated, so Apps Script only retries if the app update failed.\nNOTIFY_EMPLOYEES = false by default: flip it to true when you are ready for real not-done WhatsApps + escalations.",
        "height": 200,
        "width": 2500,
        "color": 3
      }
    },
    {
