{
  "name": "Swift Senior Checklist - Google Form + WhatsApp",
  "nodes": [
    {
      "id": "00000000-0000-0000-0000-0000000a30bd",
      "name": "Note: Flow A",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -1180,
        -330
      ],
      "parameters": {
        "content": "## A. 09:00 IST - build the form and WhatsApp it\nApp -> today's tasks -> Apps Script rebuilds the Google Form -> WhatsApp link to the Senior Authority.\nSkips if no tasks, or if the link was already sent today (set FORCE_RESEND = true to override).",
        "height": 190,
        "width": 1900,
        "color": 4
      }
    },
    {
      "id": "00000000-0000-0000-0000-0000000a4fac",
      "name": "09:00 IST - Send Form",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -1140,
        -120
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "notes": "Workflow timezone is Asia/Kolkata (see settings), so this is 09:00 IST. Must be AFTER the app's 08:30 lock-queue cron."
    },
    {
      "id": "00000000-0000-0000-0000-0000000a6e9b",
      "name": "Manual: Send Form Now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -1140,
        60
      ],
      "parameters": {}
    },
    {
      "id": "00000000-0000-0000-0000-0000000b2835",
      "name": "Config (Send Form)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -900,
        -30
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "00000000-0000-0000-0000-0000000a8d8a",
              "name": "APP_BASE_URL",
              "value": "https://swiftseniorchecklist.onrender.com",
              "type": "string"
            },
            {
              "id": "00000000-0000-0000-0000-0000000aac79",
              "name": "APPS_SCRIPT_WEBAPP_URL",
              "value": "PASTE_APPS_SCRIPT_WEB_APP_EXEC_URL",
              "type": "string"
            },
            {
              "id": "00000000-0000-0000-0000-0000000acb68",
              "name": "FORM_BRIDGE_SECRET",
              "value": "PASTE_SAME_VALUE_AS_BRIDGE_SECRET",
              "type": "string"
            },
            {
              "id": "00000000-0000-0000-0000-0000000aea57",
              "name": "FALLBACK_SENIOR_PHONE",
              "value": "",
              "type": "string"
            },
            {
              "id": "00000000-0000-0000-0000-0000000b0946",
              "name": "FORCE_RESEND",
              "value": false,
              "type": "boolean"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-0000-0000-0000000b4724",
      "name": "App: Get Todays Checklist",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -660,
        -30
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config (Send Form)').first().json.APP_BASE_URL }}/api/integrations/form/today",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 90000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_APP_SECRET_CRED",
          "name": "Swift App Secret (x-cron-secret)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 8000
    },
    {
      "id": "00000000-0000-0000-0000-0000000b8502",
      "name": "Should Send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -420,
        -30
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "00000000-0000-0000-0000-0000000b6613",
              "leftValue": "={{ $json.taskCount > 0 && (!$json.formLinkSentToday || $('Config (Send Form)').first().json.FORCE_RESEND === true) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-0000-0000-0000000ba3f1",
      "name": "Skip: Nothing To Send",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        -180,
        150
      ],
      "parameters": {},
      "notes": "No tasks published for today, or the form link was already sent."
    },
    {
      "id": "00000000-0000-0000-0000-0000000be1cf",
      "name": "Config OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -180,
        -30
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "00000000-0000-0000-0000-0000000bc2e0",
              "leftValue": "={{ $('App: Get Todays Checklist').first().json.formConfigured && !!($('App: Get Todays Checklist').first().json.senior.whatsappNumber || $('Config (Send Form)').first().json.FALLBACK_SENIOR_PHONE) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-0000-0000-0000000c00be",
      "name": "Stop: Missing Config",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        60,
        150
      ],
      "parameters": {
        "errorMessage": "={{ [ !$('App: Get Todays Checklist').first().json.formConfigured ? 'GOOGLE_FORM_URL is not set on the app (Render env)' : '', !($('App: Get Todays Checklist').first().json.senior.whatsappNumber || $('Config (Send Form)').first().json.FALLBACK_SENIOR_PHONE) ? 'Senior Authority phone is missing (Settings.seniorAuthorityPhone, SENIOR_AUTHORITY_PHONE env, or FALLBACK_SENIOR_PHONE here)' : '' ].filter(Boolean).join('; ') }}"
      }
    },
    {
      "id": "00000000-0000-0000-0000-0000000c1fad",
      "name": "Apps Script: Rebuild Form",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        60,
        -30
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config (Send Form)').first().json.APPS_SCRIPT_WEBAPP_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ secret: $('Config (Send Form)').first().json.FORM_BRIDGE_SECRET, action: 'refresh', date: $('App: Get Todays Checklist').first().json.date, choices: $('App: Get Todays Checklist').first().json.choices }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "notes": "Apps Script web apps answer with a 302 redirect; n8n follows it by default."
    },
    {
      "id": "00000000-0000-0000-0000-0000000c5d8b",
      "name": "Form Rebuilt?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        300,
        -30
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "00000000-0000-0000-0000-0000000c3e9c",
              "leftValue": "={{ $json.ok === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-0000-0000-0000000c7c7a",
      "name": "Stop: Form Not Rebuilt",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        540,
        150
      ],
      "parameters": {
        "errorMessage": "=Apps Script did not confirm the form rebuild. Response: {{ JSON.stringify($json).slice(0, 300) }}"
      },
      "notes": "Usual causes: wrong /exec URL, deployment access not 'Anyone', or FORM_BRIDGE_SECRET does not match BRIDGE_SECRET."
    },
    {
      "id": "00000000-0000-0000-0000-0000000c9b69",
      "name": "Shorten Form Link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        540,
        -30
      ],
      "parameters": {
        "url": "=https://tinyurl.com/api-create.php?url={{ encodeURIComponent($('App: Get Todays Checklist').first().json.formUrl) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "timeout": 15000
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Same TinyURL shortener the production workflows use. If it fails, the full Google Form link is sent instead."
    },
    {
      "id": "00000000-0000-0000-0000-0000000cd947",
      "name": "Form Link",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        -30
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "00000000-0000-0000-0000-0000000cba58",
              "name": "formLink",
              "value": "={{ (typeof $json.data === 'string' && $json.data.indexOf('http') === 0) ? $json.data : $('App: Get Todays Checklist').first().json.formUrl }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-0000-0000-0000000cf836",
      "name": "WhatsApp: Send Form Link to Senior",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        900,
        -30
      ],
      "parameters": {
        "phoneNumberId": "1158085794064004",
        "recipientPhoneNumber": "={{ $('App: Get Todays Checklist').first().json.senior.whatsappNumber || $('Config (Send Form)').first().json.FALLBACK_SENIOR_PHONE }}",
        "template": "senior_daily_checklist|en",
