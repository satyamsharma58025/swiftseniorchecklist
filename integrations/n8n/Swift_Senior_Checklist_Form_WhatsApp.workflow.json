          "component": [
            {
              "bodyParameters": {
                "parameter": [
                  {
                    "text": "={{ $now.setZone('Asia/Kolkata').toFormat('dd-LLL-yyyy') }}"
                  },
                  {
                    "text": "={{ $json.formLink }}"
                  }
                ]
              }
            }
          ]
        }
      },
      "credentials": {
        "whatsAppApi": {
          "id": "gnD3am3fj5pbwlEX",
          "name": "WhatsApp account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
