generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id             String                @id @default(cuid())
  name           String                @default("Default Organization")
  createdAt      DateTime              @default(now())
  activityLogs   ActivityLog[]
  queueItems     AssignmentQueueItem[]
  cronRuns       CronRunLog[]
  checklistItems DailyChecklistItem[]
  employees      Employee[]
  escalations    EscalationLog[]
  holidays       Holiday[]
  notifications  NotificationLog[]
  queueSequences QueueCodeSequence[]
  reassignments  Reassignment[]
  settings       Settings[]
  taskMasters    TaskMaster[]
  taskPauses     TaskPause[]
  users          User[]
  webhookEvents  WebhookEvent[]
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  phone          String?
  role           Role
  passwordHash   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Employee {
  id                 String                @id @default(cuid())
  name               String
  phone              String?
  designation        String
  department         String
  active             Boolean               @default(true)
  supervisorId       String?
  plantHeadId        String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  organizationId     String?
  queueItems         AssignmentQueueItem[]
  organization       Organization?         @relation(fields: [organizationId], references: [id])
  plantHead          Employee?             @relation("PlantHeadOf", fields: [plantHeadId], references: [id])
  managedByPlantHead Employee[]            @relation("PlantHeadOf")
  supervisor         Employee?             @relation("Supervises", fields: [supervisorId], references: [id])
  reports            Employee[]            @relation("Supervises")
  taskMasters        TaskMaster[]
}

model TaskMaster {
  id                  String                @id @default(cuid())
  taskCode            String                @unique
  employeeId          String
  taskDescription     String
  cadence             Cadence
  scheduleDetail      String?
  active              Boolean               @default(true)
  startDate           DateTime?             @db.Date
  endDate             DateTime?             @db.Date
  escalationThreshold Int                   @default(2)
  category            String?
  notes               String?
  priority            Priority              @default(MEDIUM)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  organizationId      String?
  queueItems          AssignmentQueueItem[]
  items               DailyChecklistItem[]
  reassignments       Reassignment[]
  employee            Employee              @relation(fields: [employeeId], references: [id])
  organization        Organization?         @relation(fields: [organizationId], references: [id])
  pauses              TaskPause[]

  @@index([active])
}

model QueueCodeSequence {
  id             String        @id @default(cuid())
  date           DateTime      @unique @db.Date
  nextValue      Int           @default(1)
  createdAt      DateTime      @default(now())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model AssignmentQueueItem {
  id              String        @id @default(cuid())
  queueCode       String        @unique
  date            DateTime      @db.Date
  employeeId      String
  taskDescription String
  source          QueueSource   @default(AUTO)
  taskMasterId    String?
  includeToday    Boolean       @default(true)
  priority        Priority
  locked          Boolean       @default(false)
  lockedAt        DateTime?
  createdAt       DateTime      @default(now())
  organizationId  String?
  employee        Employee      @relation(fields: [employeeId], references: [id])
  organization    Organization? @relation(fields: [organizationId], references: [id])
  taskMaster      TaskMaster?   @relation(fields: [taskMasterId], references: [id])

  @@unique([taskMasterId, date])
  @@index([date, locked])
}

model DailyChecklistItem {
  id                        String            @id @default(cuid())
  checklistCode             String            @unique
  date                      DateTime          @db.Date
  taskMasterId              String
  employeeName              String
  employeePhone             String?
  taskDescription           String
  supervisorName            String
  supervisorPhone           String?
  escalationThreshold       Int
  priority                  Priority
  status                    ChecklistStatus   @default(PENDING)
  seniorRemarks             String?
  employeeResponse          String?
  employeeRespondedAt       DateTime?
  reminderCount             Int               @default(0)
  lastRemindedAt            DateTime?
  escalated                 Boolean           @default(false)
  escalatedAt               DateTime?
  escalationTier            Int?
  colorStatus               ColorStatus       @default(YELLOW)
  deliveryStatus            DeliveryStatus    @default(PENDING)
  needsManualReconciliation Boolean           @default(false)
  formSubmissionTimestamp   DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  organizationId            String?
  activity                  ActivityLog[]
  organization              Organization?     @relation(fields: [organizationId], references: [id])
  taskMaster                TaskMaster        @relation(fields: [taskMasterId], references: [id])
  escalationLogs            EscalationLog[]
  notifications             NotificationLog[]

  @@unique([taskMasterId, date])
  @@index([date])
  @@index([status])
  @@index([escalated])
}

model EscalationLog {
  id                        String             @id @default(cuid())
  checklistItemId           String
  escalationTier            Int                @default(1)
  escalatedAt               DateTime           @default(now())
  reminderCountAtEscalation Int
  supervisorNotified        String
  resolved                  Boolean            @default(false)
  resolvedAt                DateTime?
  organizationId            String?
  checklistItem             DailyChecklistItem @relation(fields: [checklistItemId], references: [id])
  organization              Organization?      @relation(fields: [organizationId], references: [id])
}

model NotificationLog {
  id                String              @id @default(cuid())
  checklistItemId   String?
  channel           NotificationChannel @default(WHATSAPP)
  templateName      String
  recipientPhone    String
  status            NotificationStatus
  providerMessageId String?
  errorMessage      String?
  attemptedAt       DateTime            @default(now())
  organizationId    String?
  checklistItem     DailyChecklistItem? @relation(fields: [checklistItemId], references: [id])
  organization      Organization?       @relation(fields: [organizationId], references: [id])
}

model ActivityLog {
  id              String             @id @default(cuid())
  checklistItemId String
  actorUserId     String
  fromStatus      ChecklistStatus?
  toStatus        ChecklistStatus?
  note            String?
  createdAt       DateTime           @default(now())
  organizationId  String?
  checklistItem   DailyChecklistItem @relation(fields: [checklistItemId], references: [id])
  organization    Organization?      @relation(fields: [organizationId], references: [id])
}

model WebhookEvent {
  id             String        @id @default(cuid())
  eventId        String        @unique
  source         String
  kind           String
  payload        Json
  createdAt      DateTime      @default(now())
  processedAt    DateTime?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Holiday {
  id             String        @id @default(cuid())
  date           DateTime      @db.Date
  name           String
  appliesTo      String        @default("All")
  notes          String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model TaskPause {
  id             String        @id @default(cuid())
  taskMasterId   String
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  reason         String
  pausedByUserId String
  createdAt      DateTime      @default(now())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  taskMaster     TaskMaster    @relation(fields: [taskMasterId], references: [id])
}

model Reassignment {
  id                 String        @id @default(cuid())
  taskMasterId       String
  previousEmployeeId String
  newEmployeeId      String
  effectiveDate      DateTime      @db.Date
  reason             String
  reassignedByUserId String
  createdAt          DateTime      @default(now())
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id])
  taskMaster         TaskMaster    @relation(fields: [taskMasterId], references: [id])
}

model Settings {
  id                           Int           @id @default(1)
  reminderIntervalHoursDefault Int           @default(4)
  reminderIntervalHoursHigh    Int           @default(2)
  maxRemindersPerDayHigh       Int           @default(4)
  escalationThresholdDefault   Int           @default(2)
  escalationTier2Enabled       Boolean       @default(false)
  assignmentQueueLockTimeIst   String        @default("08:30")
  dailyFormSendTimeIst         String        @default("09:00")
  eodCutoffTimeIst             String        @default("19:00")
  timezone                     String        @default("Asia/Kolkata")
  updatedAt                    DateTime      @updatedAt
  seniorAuthorityName          String?
  seniorAuthorityPhone         String?
  organizationId               String?
  organization                 Organization? @relation(fields: [organizationId], references: [id])
}

model CronRunLog {
  id             String        @id @default(cuid())
  jobName        String
  runDate        DateTime      @db.Date
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  itemsTouched   Int?
  status         String
  errorMessage   String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@unique([jobName, runDate])
}

enum Cadence {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  QUARTERLY
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum ChecklistStatus {
  PENDING
  DONE
  NOT_DONE
}

enum ColorStatus {
  GREEN
  YELLOW
  ORANGE
  RED
  GREY
}

enum DeliveryStatus {
  SENT
  DELIVERED
  FAILED
  PENDING
}

enum QueueSource {
  AUTO
  MANUAL
}

enum Role {
  MANAGER
  SENIOR
  EMPLOYEE
}

enum NotificationChannel {
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED_NO_PHONE
  SKIPPED_OUTSIDE_WINDOW
}
