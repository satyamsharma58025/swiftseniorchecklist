+
+describe("planFormUpdates", () => {
+  it("marks ticked tasks DONE and unticked pending tasks NOT_DONE", () => {
+    const plan = planFormUpdates(items, {
+      doneRaw: ["CL-20260920-AB1 \u2014 Someone \u2014 Task [LOW]"],
+      remarksRaw: "",
+    });
